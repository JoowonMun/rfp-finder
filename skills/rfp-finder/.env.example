# rfp-finder 키 설정 예시
# 이 파일을 %USERPROFILE%\.rfp-finder\.env 로 복사한 뒤 값을 채우세요.
# - `=` 바로 뒤에 같은 줄로 붙여넣습니다. 따옴표나 공백 없이.
# - 실제 키가 든 .env 는 절대 저장소에 올리거나 대화창에 붙여넣지 마세요.

# 공공데이터포털(data.go.kr) 일반 인증키 (Decoding)
# 조달청 입찰공고정보서비스, 사전규격정보서비스 활용신청 후 발급
DATA_GO_KR_SERVICE_KEY=

# 노션 통합(Integration) 시크릿 (ntn_ 로 시작)
NOTION_TOKEN=
